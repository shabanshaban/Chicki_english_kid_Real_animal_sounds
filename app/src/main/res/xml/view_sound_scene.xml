<?xml version="1.0" encoding="utf-8"?>
<MotionScene 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="1000">
       <KeyFrameSet>
       </KeyFrameSet>
        <OnClick motion:targetId="@+id/btnSound" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/groupSlider"
            motion:layout_constraintStart_toEndOf="@+id/btnSound"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toBottomOf="@+id/btnSound"
            android:layout_marginStart="12dp"
            motion:layout_constraintTop_toTopOf="@+id/btnSound" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/groupSlider"
            motion:layout_constraintStart_toEndOf="@+id/btnSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toBottomOf="@+id/btnSound"
            android:layout_marginStart="12dp"
            motion:layout_constraintTop_toTopOf="@+id/btnSound"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp" />




    </ConstraintSet>
</MotionScene>