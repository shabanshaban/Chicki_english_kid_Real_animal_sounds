<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnPlaySound"
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:padding="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_play_poem" />

        <ProgressBar
            android:id="@+id/progressSound"
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:padding="5dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="@id/btnPlaySound"
            app:layout_constraintBottom_toBottomOf="@id/btnPlaySound"
            app:layout_constraintStart_toStartOf="@id/btnPlaySound"
            app:layout_constraintEnd_toEndOf="@id/btnPlaySound"
            />
        <com.google.android.material.slider.Slider
            android:id="@+id/seekSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:haloColor="@color/orange_text"
            app:labelBehavior="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnShareApp"
            app:layout_constraintStart_toEndOf="@+id/btnPlaySound"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbColor="@color/orange_text"
            app:thumbRadius="6dp"
            app:trackColorActive="@color/orange_color_picker"
            app:trackColorInactive="@color/colorSplash"
            app:trackHeight="3dp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnShareApp"
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:padding="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnPlaySound"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnPlaySound"
            app:srcCompat="@drawable/icon_share_voice" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>