<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lineWhatsapp"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_rounded_ripple_shape_green_direct_call">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtDirectMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"

        android:gravity="center"
        android:text="@string/message_cooperation"
        android:textColor="#ffffff"
        android:textSize="@dimen/_10sdp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imgDirectMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgDirectMessage"
        android:layout_width="@dimen/_46sdp"
        android:layout_height="@dimen/_46sdp"
        android:padding="@dimen/_4sdp"
        android:layout_margin="@dimen/_2sdp"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/shape_dash_white_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/icon_whats_app" />
</androidx.constraintlayout.widget.ConstraintLayout>